def identity<T>(x: T) -> T:
    x

def gen_eq<T: Eq<T>>(a: T, b: T) -> bool:
    let x = a == b in x

def gen_add<T: Add<T>>(a: T, b: T) -> T:
    a + b

extern "C" def test_entry() -> i32:
    identity(gen_eq(5, 7));
    gen_add(5, 6);
    identity(5);
    identity(7);
    identity(true);
    let x = identity(true) in
    x; 0