# def test_parse(a: i32, b: i32) -> i32:
#     a + b

# def test_parse2<T, U>(a: T, b: U) -> i32:
#     a == b

# typeclass Add<T>:
#     def add(T, T) -> T

# instance Add<i32>:
#     def add(self: i32, other: i32) -> i32:
#         self + other

def identity<T>(x: T) -> T:
    x

def generic_add<T: Add<T> >(a: T, b: T) -> T:
    a + b

def main() -> i32:
    identity(5);
    identity(7);
    identity(true);
    generic_add(5, 7);
    generic_add(true, false)