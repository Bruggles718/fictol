def identity<T>(x: T) -> T:
    x

# def generic_add<T: Add<T> >(a: T, b: T) -> T:
#     a + b

def gen_eq<T>(a: T, b: T) -> bool:
    a == b

def main() -> i32:
    identity(5);
    identity(7);
    identity(true);
    let x: bool = identity(true) in
    x; 0